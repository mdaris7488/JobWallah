# Used by docker-compose.yml on the server. Copy to .env and fill in every value - never commit the real .env.
CLIENT_URL=https://jobwallah.online

# MongoDB Atlas connection string (Atlas -> Connect -> Drivers). Use a DB user created just for this app.
MONGO_URI=mongodb+srv://USER:PASSWORD@your-cluster.mongodb.net/jobwallah?retryWrites=true&w=majority

# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-this-to-a-long-random-string-of-64-chars-or-more

SEED_ADMIN_NAME=JobWallah Admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=change-this-strong-unique-password

# ---- Payments (Razorpay). Leave PAYMENT_MODE=demo until you have LIVE keys and have tested end to end.
PAYMENT_MODE=demo
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Email (forgot-password code + receipts). Gmail: smtp.gmail.com / 587 / your address / 16-char App Password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=JobWallah <no-reply@jobwallah.online>
